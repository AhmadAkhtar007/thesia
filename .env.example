# Copy to .env (local) or add as Environment Variables in Vercel.
# Leave the Supabase values empty to run in demo mode with sample data in the browser.

# Supabase project URL and publishable (anon) key: Supabase dashboard > Project settings > API
THESIA_SUPABASE_URL=https://fntkopybcfxjbshmykln.supabase.co
THESIA_SUPABASE_ANON_KEY=

# Your live site address, used for sign-in email links (e.g. https://thesia.vercel.app)
THESIA_SITE_URL=

# Optional: Lemon Squeezy checkout links, as JSON. Keys are bootcamp ids, plus pro-monthly and pro-yearly.
# THESIA_CHECKOUT_URLS={"survey-sprint":"https://thesia.lemonsqueezy.com/buy/...","pro-yearly":"https://thesia.lemonsqueezy.com/buy/..."}
THESIA_CHECKOUT_URLS=
